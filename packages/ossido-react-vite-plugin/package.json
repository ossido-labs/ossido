{
  "name": "@ossido-labs/ossido-react-vite-plugin",
  "version": "0.1.6",
  "publishConfig": {
    "access": "public"
  },
  "description": "Plugin for the ossido's file system router. Ossido is the react/rust fullstack framework",
  "homepage": "https://ossido.dev",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "lint": "oxlint",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossido-labs/ossido.git",
    "directory": "packages/ossido-react-vite-plugin"
  },
  "keywords": [],
  "author": "Chris Schofield <chris@childishforces.com>",
  "license": "MIT",
  "type": "module",
  "types": "dist/esm/index.d.ts",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "oxfmt": "0.61.0",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "tsdown": "0.22.14",
    "vite-config": "workspace:*",
    "vitest": "4.1.10"
  }
}
