{
  "name": "@ossido-labs/ossido-router",
  "version": "0.1.7",
  "publishConfig": {
    "access": "public"
  },
  "description": "React routing component for the framework ossido. Ossido is the react/rust fullstack framework",
  "homepage": "https://ossido.dev",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "lint": "oxlint",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossido-labs/ossido.git",
    "directory": "packages/ossido-router"
  },
  "keywords": [],
  "author": "Chris Schofield <chris@childishforces.com>",
  "license": "MIT",
  "type": "module",
  "types": "dist/esm/index.d.ts",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "react-intersection-observer": "^9.13.0",
    "@ossido-labs/ossido-ui": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react-swc": "4.3.2",
    "happy-dom": "18.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "0.22.14",
    "vite": "^8.1.5",
    "vite-config": "workspace:*",
    "vitest": "4.1.10"
  }
}
