{
  "name": "ossido-ui",
  "version": "0.20.0",
  "description": "Default UI components and design tokens for the ossido framework. Ossido is the react/rust fullstack framework",
  "homepage": "https://ossido.dev",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "oxlint",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChildishForces/ossido.git",
    "directory": "packages/ossido-ui"
  },
  "keywords": [],
  "author": "Valerio Ageno",
  "license": "MIT",
  "type": "module",
  "types": "dist/esm/index.d.ts",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./vite-plugin": {
      "types": "./dist/esm/vite/error-overlay.d.ts",
      "default": "./dist/esm/vite/error-overlay.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@shikijs/langs": "^4.4.1",
    "@shikijs/themes": "^4.4.1",
    "hast-util-to-html": "^9.0.5",
    "shiki": "^4.4.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.5.5",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react-swc": "4.3.2",
    "happy-dom": "18.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "10.5.5",
    "tsdown": "0.22.14",
    "vite": "^8.1.5",
    "vite-config": "workspace:*",
    "vitest": "4.1.10"
  }
}
