{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["on monday"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["oxlint", "oxfmt"],
      "groupName": "devDependencies (oxc)"
    },
    {
      "description": "The opentelemetry crates and tracing-opentelemetry must be bumped in lockstep — mismatched minors produce two copies of the opentelemetry API crate.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["opentelemetry**", "tracing-opentelemetry"],
      "groupName": "opentelemetry"
    }
  ]
}
