## Node related ignores

node_modules/
dist/
.turbo/
storybook-static/

*/**/routeTree.gen.ts

examples/*/bun.lock

vite.config.ts.timestamp*

# SQLite databases created by the database-backed examples
examples/**/*.db
examples/**/*.db-*

## Rust related ignores

# Generated by Cargo
# will have compiled files and executables
**/debug/
**/target/

# Nested Cargo.locks (examples, e2e fixtures) stay ignored: they are standalone
# template projects whose users generate their own lock on scaffold. The ROOT
# workspace lock IS committed — the workspace builds binaries (the CLI, the
# examples' server), and an unlocked CI resolve made builds non-reproducible
# (e.g. an unreviewed v8 bump + a flaky static-lib download failing macOS CI).
**/Cargo.lock
!/Cargo.lock

# Per-app `.ossido/` runtime dirs (V8 code cache, generated types) — build
# artifacts wherever they appear (each example template also ignores its own)
.ossido/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Files, generated by the code editors
.vscode/

# Tarballs
*.tgz

# Prebuilt CLI binaries dropped into the per-platform npm packages at pack time
# (by CI or scripts/local-registry). The package.json/README are committed; the
# binary is a build artifact.
npm/platforms/*/bin/

# Test coverage output (cargo-llvm-cov / vitest)
coverage/

# Local Verdaccio registry (scripts/local-registry) — package storage + htpasswd
scripts/local-registry/storage/
scripts/local-registry/htpasswd

.DS_Store