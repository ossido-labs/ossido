{
  "name": "workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo dev --filter=./devtools/* --filter=./packages/*",
    "build": "turbo build --filter=./devtools/* --filter=./packages/*",
    "lint": "turbo lint --filter=./devtools/* --filter=./packages/* && cargo +nightly fmt --all --check",
    "lint:rust": "cargo +nightly fmt --all --check",
    "format:fix": "turbo format:fix --filter=./devtools/* --filter=./packages/* && cargo +nightly fmt --all",
    "format:rust:fix": "cargo +nightly fmt --all",
    "format": "turbo format --filter=./devtools/* --filter=./packages/*",
    "typecheck": "turbo typecheck --filter=./devtools/* --filter=./packages/*",
    "test": "turbo test --filter=./devtools/* --filter=./packages/*",
    "test:watch": "turbo test:watch --filter=./devtools/* --filter=./packages/*",
    "test:e2e": "bun run --filter \"./e2e/fixtures/*\" test:e2e",
    "examples:format": "oxfmt --check ./examples",
    "examples:format:fix": "oxfmt ./examples",
    "examples:typecheck": "bun run --filter \"./examples/*\" typecheck",
    "repo:root:format": "oxfmt --check . !assets/** !crates/** !examples/** !devtools/** !packages/**",
    "repo:root:format:fix": "oxfmt . !assets/** !crates/** !examples/** !devtools/** !packages/**",
    "check-packages": "turbo build test lint format typecheck --filter=!./examples",
    "check-examples": "bun run examples:format && bun run examples:typecheck",
    "check-all": "bun run check-packages && bun run check-examples && bun run repo:root:format",
    "registry:start": "bunx verdaccio@6 --config scripts/local-registry/config.yaml",
    "registry:publish": "node scripts/local-registry/publish.mjs"
  },
  "workspaces": {
    "packages": [
      "devtools/*",
      "packages/*",
      "examples/*",
      "e2e/fixtures/*"
    ]
  },
  "overrides": {
    "@types/node": "22.16.5"
  },
  "author": "Valerio Ageno",
  "license": "MIT",
  "devDependencies": {
    "@oxlint/plugins": "1.76.0",
    "@playwright/test": "1.54.1",
    "@types/node": "22.16.5",
    "@vitest/coverage-v8": "4.1.10",
    "ossido-eslint-plugin": "workspace:*",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "turbo": "2.5.5",
    "typescript": "5.8.3"
  }
}
